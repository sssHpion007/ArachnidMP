{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arachnid Music Player",
  "mainBinaryName": "arachnid",
  "version": "0.4.71",
  "identifier": "com.arachnid.musicplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arachnid Music Player",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 400,
        "maximized": true,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#141218",
        "theme": "Dark",
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--js-flags=\"--max-old-space-size=256\""
      },
      {
        "label": "lyrics",
        "title": "Arachnid Lyrics",
        "url": "index.html?miniLyrics=1",
        "width": 340,
        "height": 620,
        "minWidth": 280,
        "minHeight": 360,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#141218",
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
